# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel (produção).
# NUNCA commite valores reais. Veja o README para onde encontrar cada um no painel do Supabase.

# Supabase > Project Settings > API (a chave "anon"/publishable é pública por design; a RLS protege os dados)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Supabase > Connect > Connection string
# Aplicação (Vercel/serverless): pooler em modo "Transaction" (porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Migrations: conexão direta (porta 5432) ou pooler em modo "Session". Só usada localmente pelo drizzle-kit.
DIRECT_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# E-mail da única conta autorizada. Defesa em profundidade além de desativar o cadastro público.
OWNER_EMAIL=voce@exemplo.com
